// Config/Base.xcconfig — committed defaults.
// Do NOT put secrets here. Override keys in Config/Secrets.xcconfig (gitignored),
// which is generated by scripts/secrets-sync.sh from .env.
//
// xcconfig treats `//` as the start of a comment, so URL values CANNOT contain
// `https://`. Two strategies are used:
//   A. Host-only keys (SUPABASE_HOST, SUPABASE_URL) — AppConfiguration.swift
//      detects the missing scheme and prepends "https://".
//   B. Function path keys (GEMINI_PROXY_URL, FLAGS_BASE_URL, AUDIT_BASE_URL) —
//      Secrets.xcconfig stores them WITHOUT the leading scheme; AppConfiguration
//      synthesises the full URL from SUPABASE_HOST when these keys are blank.
//      If you set them explicitly, omit the `https://` prefix here and let
//      AppConfiguration prepend it, OR set them only in Secrets.xcconfig where
//      the value is treated as a raw string after scheme-stripping.
//
// All placeholder strings below WILL trigger a fatalError at launch via
// AppConfiguration.preflightOrCrash(). They exist only to make the key names
// visible to Xcode's xcconfig parser.

SUPABASE_URL = your-project.supabase.co
SUPABASE_ANON_KEY = REPLACE_ME

// AI gateway — maps to Edge Function `ai-gateway`.
// AppConfiguration synthesises: https://<SUPABASE_HOST>/functions/v1/ai-gateway
// Set GEMINI_PROXY_URL in Secrets.xcconfig to override (scheme-less host+path only).
GEMINI_PROXY_URL = your-project.supabase.co/functions/v1/ai-gateway

// Feature flags — maps to Edge Function `varun-validate`.
// AppConfiguration synthesises: https://<SUPABASE_HOST>/functions/v1/varun-validate
// Set FLAGS_BASE_URL in Secrets.xcconfig to override (scheme-less host+path only).
FLAGS_BASE_URL = your-project.supabase.co/functions/v1/varun-validate

// Audit ingest — maps to Edge Function `audit-ingest`.
// AppConfiguration synthesises: https://<SUPABASE_HOST>/functions/v1/audit-ingest
// Set AUDIT_BASE_URL in Secrets.xcconfig to override (scheme-less host+path only).
AUDIT_BASE_URL = your-project.supabase.co/functions/v1/audit-ingest

// Info.plist reads:
//   ${SUPABASE_URL}, ${SUPABASE_ANON_KEY}, ${GEMINI_PROXY_URL}
//   ${FLAGS_BASE_URL}, ${AUDIT_BASE_URL}
// Add the corresponding INFOPLIST_KEY_* entries to the Xcode project build
// settings if not already present (FLAGS_BASE_URL and AUDIT_BASE_URL need
// INFOPLIST_KEY_FLAGS_BASE_URL and INFOPLIST_KEY_AUDIT_BASE_URL respectively).

#include? "Secrets.xcconfig"
